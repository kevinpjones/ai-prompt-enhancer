#!/bin/bash
# Wrapper script to run auggie via npx
# This allows the prompt enhancer to use the latest auggie version
#
# Usage: Set auggiePath in your config to point to this script
#   "auggiePath": "/path/to/ai-prompt-enhancer/bin/auggie-wrapper"
#
# The SDK will pass its own arguments (--acp, --model, etc.)
# Additional arguments like --rules and --mcp-config should be set
# in the config file's "rules" and "cliArgs" options.

exec npx -y @augmentcode/auggie@latest "$@"
