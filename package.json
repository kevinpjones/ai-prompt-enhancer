{
  "name": "ai-prompt-enhancer",
  "version": "2.0.0",
  "description": "CLI tool to enhance AI prompts using multiple providers (Auggie, Claude CLI, Claude API)",
  "type": "commonjs",
  "main": "./dist/enhance-prompt.js",
  "bin": {
    "enhance-prompt": "./dist/enhance-prompt.js"
  },
  "exports": {
    ".": {
      "import": "./dist/enhance-prompt.js",
      "require": "./dist/enhance-prompt.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --banner:js=\"#!/usr/bin/env node\" --outfile=dist/enhance-prompt.js --external:@anthropic-ai/sdk && chmod +x dist/enhance-prompt.js",
    "type-check": "tsc --noEmit",
    "dev": "npm run build && node dist/enhance-prompt.js",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts' '__tests__/**/*.ts' '*.json' '*.md'",
    "format:check": "prettier --check 'src/**/*.ts' '__tests__/**/*.ts' '*.json' '*.md'"
  },
  "keywords": [
    "prompt",
    "enhancer",
    "vim",
    "ai",
    "augment",
    "claude",
    "anthropic"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@augmentcode/auggie-sdk": "^0.1.13"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitest/coverage-v8": "^2.1.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.7.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.52.0",
    "vitest": "^2.1.0"
  }
}
