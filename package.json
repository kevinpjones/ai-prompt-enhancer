{
  "name": "ai-prompt-enhancer",
  "version": "1.0.0",
  "description": "CLI tool to enhance AI prompts using Auggie SDK",
  "type": "commonjs",
  "main": "./dist/enhance-prompt.js",
  "bin": {
    "enhance-prompt": "./dist/enhance-prompt.js"
  },
  "exports": {
    ".": {
      "import": "./dist/enhance-prompt.js",
      "require": "./dist/enhance-prompt.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --banner:js=\"#!/usr/bin/env node\" --outfile=dist/enhance-prompt.js && chmod +x dist/enhance-prompt.js",
    "dev": "npm run build && node dist/enhance-prompt.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "prompt",
    "enhancer",
    "vim",
    "ai",
    "augment"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@augmentcode/auggie-sdk": "^0.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3"
  }
}
